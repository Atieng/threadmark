---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thread not found — Threadmark"
  description="This page doesn't exist."
>
  <main id="main-content" class="min-h-screen bg-mist flex flex-col items-center justify-center px-4 text-center">
    <a href="/" class="flex items-center gap-2.5 mb-12 hover:opacity-75 transition-opacity" aria-label="Threadmark home">
      <svg width="36" height="36" viewBox="0 0 40 40" aria-hidden="true">
        <path d="M9 5h18a7 7 0 0 1 7 7v10a7 7 0 0 1-7 7H17l-8 6v-6a7 7 0 0 1-7-7V12a7 7 0 0 1 7-7z" fill="#241B16"/>
        <path data-logo-stroke d="M7 15.5 L38 13 L38.6 20.5 L7.6 23 Z" fill="none" stroke="#F7C948" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="text-[20px] font-extrabold text-ink tracking-[-0.03em]">threadmark</span>
    </a>

    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-[var(--radius-btn)] border border-fog bg-white text-[13px] font-bold text-ink/50 mb-8">
      <span class="w-2 h-2 rounded-full bg-fog flex-shrink-0" aria-hidden="true"></span>
      404
    </div>

    <h1 class="text-ink mb-5" style="max-width: 18ch; font-size: clamp(32px, 5vw, 52px);">
      This thread doesn't exist.
    </h1>

    <p class="text-[17px] text-ink/55 mb-10" style="max-width: 38ch;">
      The page you're looking for isn't here. Maybe it was moved, or maybe it was never captured.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-ink text-mist text-[15px] font-bold rounded-[var(--radius-btn)] hover:bg-ink/85 transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Back to home
    </a>
  </main>
</Layout>

<script>
  import { drawLogoStroke } from '../scripts/motion.ts';
  document.addEventListener('DOMContentLoaded', () => drawLogoStroke(0.3));
</script>
