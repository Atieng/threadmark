---
import Tag from '../ui/Tag.astro';
import { Icon } from 'astro-icon/components';

// Nav items
const navItems = [
  { label: 'Knowledge base', icon: 'book-open', active: false },
  { label: 'Decisions', icon: 'check-circle', active: false },
  { label: 'Fixes', icon: 'wrench', active: false },
  { label: 'Answers', icon: 'message-circle', active: false },
  { label: 'Channels', icon: 'hash', active: false },
  { label: 'Privacy', icon: 'lock', active: false },
];

// Suggestions
const suggestions = [
  { q: 'Why do we retry webhooks 3 times?' },
  { q: 'How do I get staging access?' },
  { q: 'Who owns refunds over $500?' },
];

// Recent entries (right panel)
const recent = [
  { type: 'Decision' as const, title: 'Retry failed payment webhooks 3 times with backoff', channel: '#payments-eng', avatar: 'H', bg: '#C4623E', time: '4 min' },
  { type: 'Fix' as const, title: 'Billing cron moved to 02:00 Pacific', channel: '#billing', avatar: 'J', bg: '#C98B3A', time: '2 hrs' },
  { type: 'Answer' as const, title: 'Staging DB via Okta role eng-staging-db', channel: '#engineering', avatar: 'M', bg: '#7C5EA5', time: 'Yesterday' },
];
---

<div
  class="app-mockup w-full rounded-[var(--radius-card)] border border-fog overflow-hidden shadow-lg bg-mist"
  style="max-width: 960px; margin-inline: auto;"
  aria-label="Threadmark app preview"
  role="img"
>
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-4 py-3 border-b border-fog bg-white">
    <span class="w-3 h-3 rounded-full bg-fog"></span>
    <span class="w-3 h-3 rounded-full bg-fog"></span>
    <span class="w-3 h-3 rounded-full bg-fog"></span>
    <span class="ml-3 text-[12px] text-ink/40 font-sans">threadmark.app</span>
  </div>

  <div class="flex" style="min-height: 420px;">
    <!-- Left sidebar (hidden on mobile) -->
    <aside class="hidden md:flex flex-col w-52 flex-shrink-0 border-r border-fog bg-white p-3">
      <!-- Logo mark -->
      <div class="flex items-center gap-2 px-2 py-2 mb-4">
        <svg width="24" height="24" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M9 5h18a7 7 0 0 1 7 7v10a7 7 0 0 1-7 7H17l-8 6v-6a7 7 0 0 1-7-7V12a7 7 0 0 1 7-7z" fill="#241B16"/>
          <path d="M7 15.5 L38 13 L38.6 20.5 L7.6 23 Z" fill="#F7C948"/>
        </svg>
        <span class="text-[13px] font-bold text-ink">threadmark</span>
      </div>

      <!-- Nav items -->
      <nav aria-label="Sidebar navigation">
        {navItems.map((item) => (
          <div
            class={`flex items-center gap-2.5 px-3 py-2 rounded-[var(--radius-sm)] text-[13px] cursor-default mb-0.5 ${item.active ? 'bg-ink text-mist' : 'text-ink/60 hover:bg-fog/50'}`}
          >
            <Icon name={`lucide:${item.icon}`} size={15} stroke-width={1.75} class="flex-shrink-0 text-current" aria-hidden="true" />
            {item.label}
          </div>
        ))}
      </nav>

      <!-- User card -->
      <div class="mt-auto pt-3 border-t border-fog">
        <div class="flex items-center gap-2 px-2">
          <div class="w-7 h-7 rounded-full bg-moss/30 flex items-center justify-center text-[11px] font-bold text-moss">H</div>
          <div>
            <p class="text-[12px] font-bold text-ink leading-none">Hannah K.</p>
            <p class="text-[11px] text-ink/40 leading-none mt-0.5">Admin</p>
          </div>
        </div>
      </div>
    </aside>

    <!-- Centre: search -->
    <main class="flex-1 min-w-0 p-5 md:p-6">
      <div class="max-w-[480px]">
        <p class="text-[12px] font-bold text-ink/40 mb-3">Ask your team's memory</p>

        <!-- Search bar -->
        <div class="flex items-center gap-3 border-2 border-fog rounded-[var(--radius-btn)] px-4 py-3 bg-white mb-5 focus-within:border-moss transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink/30 flex-shrink-0" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <span class="text-[14px] text-ink/30">Search or ask anything…</span>
        </div>

        <!-- Suggestions -->
        <div class="space-y-2">
          {suggestions.map((s) => (
            <button
              class="w-full text-left px-4 py-3 rounded-[var(--radius-sm)] border border-fog bg-white hover:border-moss/40 hover:bg-mist transition-all text-[13px] text-ink/70 flex items-center gap-3"
              type="button"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink/30 flex-shrink-0" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              {s.q}
            </button>
          ))}
        </div>
      </div>
    </main>

    <!-- Right: recently captured (hidden on mobile, only first entry on tablet) -->
    <aside class="hidden lg:flex flex-col w-64 flex-shrink-0 border-l border-fog bg-white p-4">
      <p class="text-[11px] font-bold text-ink/40 mb-3">Recently captured</p>
      <div class="space-y-3">
        {recent.map((entry, i) => (
          <div
            class={`p-3 rounded-[var(--radius-sm)] border border-fog bg-white ${i > 0 ? 'hidden xl:block' : ''}`}
            data-hero="entry"
          >
            <div class="flex items-center justify-between mb-2">
              <Tag type={entry.type} />
              <span class="text-[11px] text-ink/30">{entry.time}</span>
            </div>
            <p class="entry-title text-[13px] leading-[1.3] mb-2">{entry.title}</p>
            <div class="flex items-center justify-between">
              <div
                class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold text-white"
                style={`background-color: ${entry.bg}`}
                aria-hidden="true"
              >
                {entry.avatar}
              </div>
              <span class="text-[11px] text-moss">{entry.channel}</span>
            </div>
          </div>
        ))}
      </div>
    </aside>
  </div>
</div>
