---
// Blurred DM thread with a lock overlay and a summary card below.
// The blurred section is aria-hidden; the summary card carries the accessible content.
---

<div class="rounded-[var(--radius-card)] bg-white shadow-warm overflow-hidden" style="font-size: 13px;">
  <!-- DM header -->
  <div class="flex items-center gap-2 px-4 py-2.5 border-b border-fog">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-ink/30">
      <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span class="font-bold text-ink/50">Direct message — Lena &amp; Ravi</span>
  </div>

  <!-- Blurred messages (aria-hidden) -->
  <div class="relative px-4 py-3 space-y-2.5" aria-hidden="true">
    <div class="flex gap-2 items-start">
      <span class="w-6 h-6 rounded-full flex-shrink-0 flex items-center justify-center text-[10px] font-bold text-white" style="background: #2F6F6A;">L</span>
      <div class="flex-1 space-y-1">
        <div class="h-2.5 rounded bg-ink/12 w-3/4" style="filter: blur(2px);"></div>
        <div class="h-2.5 rounded bg-ink/12 w-1/2" style="filter: blur(2px);"></div>
      </div>
    </div>
    <div class="flex gap-2 items-start justify-end">
      <div class="flex-1 space-y-1 flex flex-col items-end">
        <div class="h-2.5 rounded bg-ink/12 w-2/3" style="filter: blur(2px);"></div>
      </div>
      <span class="w-6 h-6 rounded-full flex-shrink-0 flex items-center justify-center text-[10px] font-bold text-white" style="background: #C98B3A;">R</span>
    </div>
    <div class="flex gap-2 items-start">
      <span class="w-6 h-6 rounded-full flex-shrink-0 flex items-center justify-center text-[10px] font-bold text-white" style="background: #2F6F6A;">L</span>
      <div class="flex-1 space-y-1">
        <div class="h-2.5 rounded bg-ink/12 w-5/6" style="filter: blur(2px);"></div>
        <div class="h-2.5 rounded bg-ink/12 w-3/5" style="filter: blur(2px);"></div>
        <div class="h-2.5 rounded bg-ink/12 w-2/5" style="filter: blur(2px);"></div>
      </div>
    </div>
    <!-- Lock badge -->
    <div class="absolute inset-0 flex items-center justify-center bg-white/60 backdrop-blur-[2px]">
      <div class="flex flex-col items-center gap-1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-ink/40">
          <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.75"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
        <span class="text-[10px] font-bold text-ink/40">Private</span>
      </div>
    </div>
  </div>

  <!-- Summary card (accessible outcome) -->
  <div class="mx-3 mb-3 p-3 rounded-[var(--radius-sm)] bg-moss/8 border border-moss/20">
    <div class="flex items-center gap-1.5 mb-2">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="text-moss flex-shrink-0">
        <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="text-[11px] font-bold text-moss">Summary only</span>
    </div>
    <p class="text-[12px] text-ink/80 leading-[1.45] mb-2">
      Team decided to cap webhook retries at 3. Approved by 3 of 3 members.
    </p>
    <div class="flex items-center gap-1">
      {['L', 'R', 'T'].map((initial, i) => (
        <div class="flex items-center gap-0.5">
          <span
            class="w-4.5 h-4.5 rounded-full text-[9px] font-bold text-white flex items-center justify-center"
            style={`background: ${i === 0 ? '#2F6F6A' : i === 1 ? '#C98B3A' : '#2F6F6A'};`}
          >{initial}</span>
          <svg width="8" height="8" viewBox="0 0 24 24" fill="none" class="text-moss">
            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      ))}
    </div>
  </div>
</div>
