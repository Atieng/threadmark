---
import Tag from '../ui/Tag.astro';
import messages from '../../content/messages.json';
import entries from '../../content/entries.json';

const demoMessages = messages.demo;
const demoEntry = entries.entries[0];
---

<section
  class="live-capture py-20 md:py-28 bg-blush"
  aria-labelledby="demo-heading"
  id="demo"
  data-animated-section
>
  <div class="container">
    <div class="text-center mb-12">
      <h2 id="demo-heading" data-reveal="text" class="text-ink mb-3">
        Watch a decision get captured.
      </h2>
      <p class="text-[17px] text-ink/60 mx-auto" style="max-width: 44ch;">
        A real Slack thread. Threadmark spots the outcome and drafts the entry.
      </p>
    </div>

    <div
      data-demo
      class="grid md:grid-cols-2 gap-8 items-start max-w-[900px] mx-auto"
    >
      <!-- Slack thread mockup -->
      <div data-slide="left" class="slack-thread rounded-[var(--radius-card)] border border-fog bg-white overflow-hidden shadow-sm">
        <!-- Thread header -->
        <div class="px-4 py-3 border-b border-fog bg-gray-50 flex items-center gap-2.5">
          <span class="text-ink/40 text-[14px]">#</span>
          <span class="text-[14px] font-bold text-ink">payments-eng</span>
          <span class="ml-auto text-[12px] text-ink/30">Slack</span>
        </div>

        <!-- Messages -->
        <div class="p-4 space-y-1 min-h-[200px]">
          {demoMessages.map((msg, i) => (
            <div
              data-msg
              data-msg-index={i}
              class="flex gap-3 py-2"
            >
              <!-- Avatar -->
              <div
                class="w-8 h-8 rounded-sm flex-shrink-0 flex items-center justify-center text-[13px] font-bold text-white leading-none mt-0.5"
                style={`background-color: ${msg.avatarBg}`}
                aria-hidden="true"
              >
                {msg.avatar}
              </div>
              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 mb-0.5">
                  <span class="text-[14px] font-bold text-ink">{msg.author}</span>
                  <time class="text-[12px] text-ink/30">{msg.time}</time>
                </div>
                <p class={`text-[14px] leading-[1.5] m-0 max-w-none relative ${msg.highlight ? 'font-medium' : 'text-ink/75'}`}>
                  {msg.highlight && (
                    <span
                      data-highlight-bg
                      class="absolute inset-[-3px_-5px] bg-highlighter rounded-[3px] -z-10"
                      style="transform-origin: left center; transform: scaleX(0);"
                      aria-hidden="true"
                    ></span>
                  )}
                  {msg.text}
                </p>
              </div>
            </div>
          ))}

          <!-- Typing indicator -->
          <div data-typing class="flex gap-3 py-2 opacity-0">
            <div class="w-8 h-8 rounded-sm bg-fog flex-shrink-0" aria-hidden="true"></div>
            <div class="flex items-center gap-1 pt-2" aria-label="Someone is typing">
              <span class="w-2 h-2 rounded-full bg-ink/30 animate-bounce" style="animation-delay: 0ms"></span>
              <span class="w-2 h-2 rounded-full bg-ink/30 animate-bounce" style="animation-delay: 150ms"></span>
              <span class="w-2 h-2 rounded-full bg-ink/30 animate-bounce" style="animation-delay: 300ms"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Entry card (slides in) -->
      <div data-slide="right" class="entry-col" style="position: relative;">
        <div
          data-entry-card
        >
          <article
            class="bg-mist border border-fog rounded-[var(--radius-card)] p-5"
            style="box-shadow: 5px 5px 0 0 var(--color-ink);"
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <Tag type="Decision" />
              <span class="text-[12px] text-ink/30">just now</span>
            </div>

            <h3 class="entry-title text-[17px] leading-[1.35] mb-3">
              Retry failed payment webhooks 3 times with backoff, then send to manual review
            </h3>

            <p class="text-[12px] text-ink/50 mb-4">
              Replaces: <em>"Retry webhooks indefinitely"</em>
            </p>

            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <div
                  class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold text-white"
                  style="background: #C4623E;"
                >H</div>
                <span class="text-[12px] text-ink/60">Decided by Hannah K.</span>
              </div>
              <a href="#" class="text-[12px] text-moss hover:underline">View thread</a>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-4 border-t border-fog">
              <button
                class="demo-confirm px-4 py-2.5 bg-moss text-mist text-[13px] font-bold rounded-[var(--radius-btn)] hover:brightness-105 transition-all"
                type="button"
              >
                Confirm entry
              </button>
              <button
                class="demo-edit px-4 py-2.5 bg-transparent border border-fog text-ink text-[13px] font-bold rounded-[var(--radius-btn)] hover:bg-fog/50 transition-all"
                type="button"
              >
                Edit first
              </button>
            </div>

            <!-- Confirmed message -->
            <p
              data-confirmed
              class="mt-3 text-[13px] text-moss font-bold"
              hidden
            >
              Confirmed — now searchable by your team.
            </p>
          </article>
        </div>

        <!-- Replay -->
        <button
          data-replay
          class="mt-4 text-[13px] text-moss font-bold hover:underline underline-offset-2 transition-all"
          type="button"
          hidden
        >
          ↺ Replay
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { playThread } from '../../scripts/demo.ts';
  playThread('[data-demo]');
</script>
