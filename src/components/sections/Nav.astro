---
import { Icon } from 'astro-icon/components';
const navLinks = [
  { label: 'Product', href: '#how-it-works' },
  { label: 'Privacy', href: '#privacy' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'FAQ', href: '#faq' },
];
---

<header
  data-nav
  data-hero="nav"
  class="nav fixed top-0 inset-x-0 z-50 transition-all duration-300"
  style="--nav-bg: transparent;"
>
  <div class="container flex items-center justify-between h-16 gap-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 flex-shrink-0 group" aria-label="Threadmark home">
      <svg
        width="32"
        height="32"
        viewBox="0 0 40 40"
        aria-hidden="true"
        class="logo-svg"
      >
        <path
          d="M9 5h18a7 7 0 0 1 7 7v10a7 7 0 0 1-7 7H17l-8 6v-6a7 7 0 0 1-7-7V12a7 7 0 0 1 7-7z"
          fill="#241B16"
        />
        <path
          data-logo-stroke
          d="M7 15.5 L38 13 L38.6 20.5 L7.6 23 Z"
          fill="none"
          stroke="#F7C948"
          stroke-width="8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="text-[18px] font-extrabold tracking-[-0.03em] text-ink">threadmark</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-2 text-[14px] font-bold text-ink/60 hover:text-ink rounded-[var(--radius-sm)] hover:bg-fog/40 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="#"
        class="text-[14px] font-bold text-ink/60 hover:text-ink transition-colors"
      >
        Sign in
      </a>
      <a
        href="#early-access"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-ember text-ink text-[14px] font-bold rounded-[var(--radius-btn)] hover:brightness-105 hover:scale-[1.02] active:scale-[0.97] transition-all duration-[var(--dur-fast)]"
      >
        <Icon name="logos:slack-icon" size={16} aria-hidden="true" />
        Add to Slack
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="md:hidden p-2 rounded-[var(--radius-sm)] text-ink hover:bg-fog/40 transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="hamburger"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" id="icon-menu">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" id="icon-close" class="hidden">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-fog bg-mist/95 backdrop-blur-md px-4 pb-4"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-1 pt-3" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-3 text-[15px] font-bold text-ink rounded-[var(--radius-sm)] hover:bg-fog/40 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#"
        class="px-3 py-3 text-[15px] font-bold text-ink/60 rounded-[var(--radius-sm)] hover:bg-fog/40 transition-colors"
      >
        Sign in
      </a>
    </nav>
    <a
      href="#early-access"
      class="mt-3 flex items-center justify-center gap-2 px-5 py-3 bg-ember text-ink text-[15px] font-bold rounded-[var(--radius-btn)]"
    >
      Add to Slack
    </a>
  </div>
</header>

<style>
  /* Nav: mist at 85% opacity with blur, only after scrolling */
  [data-nav][data-scrolled] {
    background: rgba(238, 242, 238, 0.88); /* --mist at 88% */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #E6D9CC; /* --fog */
    box-shadow: 0 1px 0 0 #E6D9CC;
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  hamburger?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    menu?.setAttribute('aria-hidden', String(isOpen));
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!hamburger?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      if (!menu?.classList.contains('hidden')) {
        menu?.classList.add('hidden');
        hamburger?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        iconMenu?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    }
  });

  // Close mobile menu on nav link click
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      hamburger?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
